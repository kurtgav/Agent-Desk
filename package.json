{
  "name": "agentdeck",
  "productName": "AgentDeck",
  "version": "0.1.0",
  "private": true,
  "description": "Local Windows dashboard for every Claude Code session on this PC.",
  "author": "Third Code",
  "license": "MIT",
  "repository": "github:kurtgav/Agent-Desk",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:smoke": "electron-vite build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:smoke",
    "scratch:hooks": "node scripts/scratch-hooks.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "clsx": "2.1.1",
    "cross-spawn": "7.0.6",
    "electron": "45.2.2",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
